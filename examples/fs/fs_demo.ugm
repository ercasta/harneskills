# Filesystem bookkeeping, over `ugm/repl_fs.py`'s tools. Run interactively:
#
#     python -m ugm.fs_repl
#
# `ls` is a read-only tool and fires freely. `rename` is declared as an
# `action` and every rename this corpus itself proposes is held for approval
# by the SAME mechanism as `tools_approval.ugm`'s `deploy` -- a write-time
# trigger, not a special case in the engine. A rename typed directly by a
# person at the REPL (`fact +rename(...)`) is not produced by
# `<propose-rename>`, so `<hold-rename>` does not see it and it fires
# immediately -- the gate holds what an AUTOMATION proposes, not everything
# of that shape. Wanting a person's own renames held too is one more
# `<hold-...>` rule, not a different mechanism.

action rename($dir, $old, $new)

# `fact +want(list("some path"))`, typed at the REPL or by another rule,
# deposits the goal; this is the whole of what turns it into a tool call.
rule <list> = implies( { +want(list($dir)) },
                       { +ls($dir), -want(list($dir)) } )

# An INTAKE rule: `ugm/repl.py` hears anything that fails to parse as a
# proposition as `sentence(w1, w2, ...)` instead of refusing it -- typing
# `show file in "some path"` (no sign, no parens: not `.ugm` at all)
# delivers `sentence(show, file, in, "some path")` on the same `user`
# channel `say` uses. This rule is what gives THAT shape a meaning, by
# concluding the exact same goal the precise form would have written --
# canonicalization is nothing but an ordinary rule reading an ordinary
# arrival. `no heard(...)` is not optional: `says(user, ...)` persists
# (nothing ever retracts an utterance), so without it this rule re-fires
# every time `<list>` consumes `want(list($dir))`, forever -- the same
# discipline `<trust-user>` (`ugm/repl.py`) needed for the same reason.
rule <intake-show> = implies(
    { +says(user, sentence(show, file, in, $dir)), no heard(sentence(show, file, in, $dir)) },
    { +want(list($dir)), +heard(sentence(show, file, in, $dir)) } )
=> attend($dir, 5)

# `fact +want(stale_after("some path", 7))`. Every file `ls` found under
# $dir, at least $days old by `now` (`ugm/fs_repl.py` seeds `now` once at
# start), is flagged -- one rule, however many files `ls` found.
# `no considered(...)` guards it, and `+considered` lands in the SAME
# firing that decides -- not a later stage -- because a guard the rule's own
# match does not immediately satisfy is no guard at all: the engine reselects
# whatever still matches every tick, and a still-open binding it already
# looked at wins arbitration again forever (the discipline `docs/guide.md`'s
# `<pay>` spends `-pays(...)` on). It also makes asking again about the same
# directory idempotent -- only files new since are reconsidered.
#
# `<flag-stale>` is exactly the rule that starved this way before the
# guard existed, so it is also the one watched by
# `ugm/rules/circuit_breaker.ugm` (loaded by `ugm/fs_repl.py`) -- belt and
# suspenders: the guard should always be enough, and if a future edit
# breaks it, 1000 unproductive reselections trips dormancy instead of
# quietly burning the whole tick budget.
fact +watched(<flag-stale>, flag_stale_tag)
fact +tries(flag_stale_tag, 0)
fact +threshold(flag_stale_tag, 1000)
fact +cooldown_len(flag_stale_tag, 50)

rule <flag-stale> = implies(
    { +want(stale_after($dir, $days)), +file($dir, $name), no considered($dir, $name),
      +created($dir, $name, $c), +now($t),
      age_days($t, $c) as $age, at_least($age, $days) as $old },
    { +stale($dir, $name), +considered($dir, $name) } )

# The compounding step the bet is about: staleness becomes a GOAL
# (`+rename(...)`), not a direct act. A corpus that wanted to archive
# instead of rename changes only this rule -- `<list>`, the tools and the
# approval gate are untouched.
rule <propose-rename> = implies(
    { +stale($dir, $name), prefixed($name) as $new },
    { +rename($dir, $name, $new), -stale($dir, $name) } )

fact +intercepts(<hold-rename>, after)
rule <hold-rename> = implies(
    { +producing(<propose-rename>, rename($dir, $old, $new)) },
    { +instead(rename($dir, $old, $new), pending(rename($dir, $old, $new))) } )

rule <approved-rename> = implies(
    { +answered(<approve>, pending(rename($dir, $old, $new)), yes) },
    { +rename($dir, $old, $new), -pending(rename($dir, $old, $new)),
      -answered(<approve>, pending(rename($dir, $old, $new)), yes) } )

rule <denied-rename> = implies(
    { +answered(<approve>, pending(rename($dir, $old, $new)), no) },
    { -pending(rename($dir, $old, $new)),
      -answered(<approve>, pending(rename($dir, $old, $new)), no) } )

# The same intake, one word shorter. `show file` on its own is
# `sentence(show, file)` -- two words, so <intake-show> above (which wants
# `show file in $dir`) cannot match it, and the sentence just sits there
# believed and inert. It is the FIRST thing anyone types, because the REPL's
# own help offers a bare "show files" as its example of a sentence --
# illustrating the mechanism, not promising this corpus knows the words. So
# give it the meaning it obviously wants: the directory the session started
# in, which `fs.py:register` writes once as `cwd`.
#
# ⚠ `file`, SINGULAR, and singular everywhere in this corpus on purpose. It
# is already the vocabulary -- `ls` writes `file($dir, $name)` -- so typing
# the plural is one edit away from a word the machine knows, and the REPL's
# autocorrect turns `show files` into this rule for free (`~ files -> file`).
# Spell the intake plural instead and you get the opposite: `files` is then
# the only place the word occurs, `file` is a different word that happens to
# be a relation, and nothing relates them. One spelling, and near misses
# fall towards it.
#
# What this does NOT buy is `show fi`: `_autocorrect` never considers a span
# of two characters or fewer, whatever the distance, because at that length
# everything is near everything. That guard is `harneskills/repl.py`'s and
# no corpus can spell its way out of it.
rule <intake-show-here> = implies(
    { +says(user, sentence(show, file)), no heard(sentence(show, file)),
      +cwd($dir) },
    { +want(list($dir)), +heard(sentence(show, file)) } )
=> attend($dir, 5)


# -- what is big, HERE ---------------------------------------------------
# `show big` answers about the folder you are looking at, and it knows which
# one that is because listing a folder ATTENDS it: the `=> attend($dir, 5)`
# tails above. Attention is the engine's own (`ugm/core/attention.py`), not
# a fact this corpus keeps -- a claim that fades on its own clock, five
# ticks here, restored to five whenever a move touches the folder again.
#
# Three rules rather than one, and the middle one is the whole point.

fact +big_is(1000)

# One `want`, and it can be ASKED AGAIN -- which the rules above cannot be,
# and the difference is worth the paragraph.
#
# An utterance is identified by its CONTENT: `Machine._deliver` writes
# `arrived(user, sentence(show, big))` and nothing else, so saying the same
# words twice writes a proposition already believed, which is no write at
# all. Belief cannot tell you said it twice, and that is why every rule
# above keys on `says(...)` behind a guard it never releases -- `says` never
# changes, so a rule without one fires every tick for ever.
#
# ATTENTION can tell. Saying something attends it, restored to its start
# whether or not the belief moved, and fading from there -- so the second
# `show big` is a real event even though nothing new became true. The guard
# is released by the same clock that made it necessary: <rearm-big> waits
# for the sentence to fade out of mind, and then this rule is ready to hear
# it again. Nothing is retracted, no utterance is unsaid, and the corpus
# does not have to pretend an occasion was a fact.
#
# `... as $s, attentioned($s)` -- NOT `attentioned(sentence(show, big))`
# written out, even though both parsed and `<focus-big>`'s own
# `attentioned($dir)` below looks the same shape. A ground literal typed
# directly inside a PREDICATE call is never resolved against belief the
# way an ordinary `+`/`no` member is -- `core/rules.py`'s own match loop
# `walk()`s a predicate's arguments and hands them to `attentioned(...)`
# UNCHANGED, where every other member goes through `unify`, which is
# structural. `sentence(show, big)` typed here built its OWN node at LOAD
# TIME, and UGM stopped interning ("never intern": `Graph.rel` mints a
# distinct node every call), so that node is never the one the channel
# delivered and the engine actually attended -- `attentioned(<the rule's
# own copy>)` asks about an occasion nothing ever touches, always false,
# silently. `as $s` binds what `+says(user, sentence(show, big))` itself
# MATCHED -- found by `unify`, the real occasion -- and `attentioned($s)`
# asks about THAT. `<focus-big>`'s `attentioned($dir)` was never wrong:
# `$dir` there is already bound the same way, off `+file($dir, $name)`.
rule <intake-show-big> = implies(
    { +says(user, sentence(show, big)) as $s, attentioned($s),
      +big_is($min), no asked_big(yes) },
    { +want(big_here($min)), +asked_big(yes) } )

# `no` on a PREDICATE, which is the other half of the same idea: asked once
# while the sentence is in mind, and armed again once it is not. Same fix
# as `<intake-show-big>` and for the same reason -- `says(user, ...)`
# never retracts, so it is always there to bind `$s` from, exactly when
# this rule needs to ask about it.
rule <rearm-big> = implies(
    { +asked_big(yes), +says(user, sentence(show, big)) as $s, no attentioned($s) },
    { -asked_big(yes) } )

# WHICH folder. This fires exactly once -- it spends the `want` that let it
# match -- and that is what makes "here" mean the LAST folder rather than
# every folder ever listed. `attentioned($dir)` only says $dir is in the
# attention pool at all, and a folder listed ten moves ago is still in it
# (a standing claim does not fade the way the queue does); what separates
# them is that the engine ranks a rule's own applications by attention,
# newest and strongest first, so the one binding takes is the folder just
# looked at. List A, list B, ask: you get B.
rule <focus-big> = implies(
    { +want(big_here($min)), +file($dir, $name), attentioned($dir) },
    { +want(big_files($min, $dir)), -want(big_here($min)) } )

# Then every file in THAT folder, one rule however many files `ls` found --
# `<flag-stale>`'s shape exactly, down to the guard landing in the same
# firing that decides. `at_least` answers nothing when the file is too
# small, and a computator that binds nothing is a rule that does not match:
# the filter IS the match.
rule <flag-big> = implies(
    { +want(big_files($min, $dir)), +file($dir, $name),
      +size($dir, $name, $bytes), no weighed($dir, $name),
      at_least($bytes, $min) as $ok },
    { +big($dir, $name), +weighed($dir, $name) } )


# -- OUTPUT ---------------------------------------------------------------
# `harneskills/repl.py` prints exactly one shape unasked: a freshly
# concluded `reply(user, $text)` (see that module's docstring, "The output
# boundary is a channel too"). Everything above this line decides WHAT
# happened; these rules are the ones that decide what a person reading the
# prompt is TOLD about it -- an "outtake" set, symmetric to the
# `<intake-...>` rules above, and just as replaceable: a corpus that wants
# quieter or louder replies edits these, not the harness.
#
# Every one keys on an ANSWER (`answered(<tool>, request, said)`) or a
# WRITTEN fact rather than on the request itself, because that is what
# `_answer`/a move already attends the moment there is something to
# report -- the request alone can fire before the tool has run. `no
# replied(...)` is the same brake every rule above needs and for the same
# reason (`<flag-stale>`'s own note): ONE reply per occasion, not one per
# tick it stays believed. None of these re-arm the way `<intake-show-big>`
# does -- a second `show file` on the SAME folder stays quiet, a known
# simplification, not an oversight; re-arming on attention fading is the
# same technique, just not spent twice in one corpus.

rule <reply-listed> = implies(
    { +answered(<ls>, ls($dir), $n), no replied(ls($dir)),
      listed_msg($dir, $n) as $msg },
    { +reply(user, $msg), +replied(ls($dir)) } )

# The count alone does not say WHAT is there -- one reply per entry `ls`
# found, `<flag-big>`'s own shape ("one rule however many files ls
# found"), so `show file` still lists, the same job the old raw belief
# diff did before this corpus had a reply channel at all.
#
# `+answered(<ls>, ls($dir), $n)` is not read for `$n` here -- it is the
# ANCHOR. `ls` writes `file(...)`/`size(...)` directly (`fs_tools.py`'s own
# `deposit`, through the gate, not through a rule's own consequent), so
# neither carries any attention of its own -- only the answer itself does
# (`Machine._answer`'s own `_attend_written`), the same reason
# `<reply-listed>` reads it. Without this line every candidate here scores
# zero overlap and none of them are ever offered, silently -- `show file`
# announcing a count and then nothing is exactly that, found live.
rule <reply-file> = implies(
    { +answered(<ls>, ls($dir), $n), +file($dir, $name), +size($dir, $name, $bytes),
      no replied(file($dir, $name)), sized_msg($name, $bytes) as $msg },
    { +reply(user, $msg), +replied(file($dir, $name)) } )

# Both rules above CONSUME the one `answered(<ls>, ...)` occasion every
# time either of them fires ("using a thing is what takes it off the
# list", `core/attention.py`'s own note) -- and two rules sharing one
# occasion is exactly the case that note says needs an explicit re-attend,
# not an inferred one. Found live: with only `<reply-listed>` reading it,
# it always won by default; the moment `<reply-file>` started reading the
# SAME occasion too, whichever of them fired first on a given tick
# silently starved the rest for the whole directory -- `show file`
# reporting a count and naming not one entry, or naming every entry and
# never a count, depending on which rule the table happened to rank
# first. `brush(...)` is not the fix here either, for the same reason
# `<trust-user>` needed `after ... => attend(...)` instead of it: it
# REBUILDS `answered(<ls>, ls($dir), $n)` by substitution, which mints a
# twin now that UGM no longer interns. A QUERY, never a rebuild.
after <reply-listed> { $a = answered(<ls>, ls($dir), $n) } => attend($a, 5, 1, 1)
after <reply-file> { $a = answered(<ls>, ls($dir), $n) } => attend($a, 5, 1, 1)

rule <reply-big> = implies(
    { +big($dir, $name), +size($dir, $name, $bytes), no replied(big($dir, $name)),
      sized_msg($name, $bytes) as $msg },
    { +reply(user, $msg), +replied(big($dir, $name)) } )

# Fires whichever way a rename actually happened -- typed directly, or
# approved through `<approved-rename>` -- because both paths end in the
# same ordinary `+rename($dir, $old, $new)`, and `<rename>` (`fs_tools.py`)
# answers it either way. Nothing here needs to know which.
rule <reply-renamed> = implies(
    { +answered(<rename>, rename($dir, $old, $new), done),
      no replied(rename($dir, $old, $new)), renamed_msg($old, $new) as $msg },
    { +reply(user, $msg), +replied(rename($dir, $old, $new)) } )
